{
  "name": "itemx2",
  "private": true,
  "version": "2.6.1",
  "license": "GPL-3.0-or-later",
  "itemxUpdateUrl": "https://raw.githubusercontent.com/canister2668/itemx2/refs/heads/main/dist/itemx2.plugin.js",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src tests scripts eslint.config.js",
    "format": "prettier --write package.json eslint.config.js src tests scripts",
    "format:check": "prettier --check package.json eslint.config.js src tests scripts",
    "pretest": "npm run build",
    "test": "node --import ./tests/helpers/register.mjs --test tests/*.test.mjs",
    "preview:screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.6"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
